# PhishTriage SOC Toolkit — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# IMPORTANT: Never commit your .env file to version control.
# Add .env to your .gitignore file.

# Your Gemini API key from Google AI Studio (https://aistudio.google.com/)
# If you prefer, the UI also accepts the key at runtime via the header input.
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model (default: gemini-1.5-flash)
# Other options: gemini-1.5-pro (more capable, slower), gemini-2.0-flash-exp
VITE_GEMINI_MODEL=gemini-1.5-flash
